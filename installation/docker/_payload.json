:136},"    ports",[130,187,160],{"class":140},[130,189,191,194,197,200],{"class":132,"line":190},6,[130,192,193],{"class":140},"      -",[130,195,196],{"class":140}," \"",[130,198,199],{"class":147},"6977:80",[130,201,202],{"class":140},"\"\n",[130,204,206,209],{"class":132,"line":205},7,[130,207,208],{"class":136},"    environment",[130,210,160],{"class":140},[130,212,214,216,219],{"class":132,"line":213},8,[130,215,193],{"class":140},[130,217,218],{"class":147}," FIREFLY_URL=https://firefly.domain.com",[130,220,222],{"class":221},"sTEyZ","  \n",[130,224,226,229],{"class":132,"line":225},9,[130,227,228],{"class":136},"    volumes",[130,230,160],{"class":140},[130,232,234,236],{"class":132,"line":233},10,[130,235,193],{"class":140},[130,237,238],{"class":147}," /path/firefly-pico-data:/var/www/html/database/data\n",[240,241,242,264],"note",{},[107,243,244,245,249,250,252,253,256,257,260,261],{},"Make sure the environment variable ",[246,247,248],"u",{},"FIREFLY_URL"," points to your ",[111,251,113],{}," instance. This can be either IP + Port (ex. ",[127,254,255],{},"http://192.168.1.99:8080",") or subdomain (ex. ",[127,258,259],{},"https://firefly.domain.com",") if you use a reverse proxy like Nginx Proxy Manager.\n",[262,263],"br",{},[265,266,267],"ul",{},[268,269,270],"li",{},"Set the volume to a persistent folder for the SQLite database.",[265,272,273,284],{},[268,274,244,275,249,277,252,279,256,281,283],{},[111,276,248],{},[111,278,113],{},[127,280,255],{},[127,282,259],{},") if you use a reverse proxy like Nginx Proxy Manager.",[268,285,270],{},[287,288,290],"h3",{"id":289},"other-variants","Other variants:",[107,292,293,294,296],{},"If you don't yet have ",[111,295,113],{}," installed and want both inside a single Docker-compose file:",[265,298,299,308],{},[268,300,301],{},[302,303,307],"a",{"href":304,"rel":305},"https://github.com/cioraneanu/firefly-pico/blob/main/docker-compose.pico+firefly.yml",[306],"nofollow","Pico + Firefly",[268,309,310,315],{},[302,31