/completions",[366,443,444,449],{},[381,445,446],{},[127,447,448],{},"ASSISTANT_LLM_MODEL",[381,450,451,452,402],{},"LLM model name. (Default: ",[127,453,454],{},"gpt-4o-mini",[366,456,457,462],{},[381,458,459],{},[127,460,461],{},"ASSISTANT_LLM_API_KEY",[381,463,464],{},"API key for the LLM endpoint.",[366,466,467,472],{},[381,468,469],{},[127,470,471],{},"ASSISTANT_LLM_CONTEXT",[381,473,474],{},"Extra instructions appended to every Ramble interpretation.",[366,476,477,482],{},[381,478,479],{},[127,480,481],{},"ASSISTANT_TRANSCRIPTION_ENDPOINT",[381,483,484,485,402],{},"OpenAI-compatible audio transcription endpoint for voice rambles. (Default: ",[127,486,487],{},"https://api.openai.com/v1/audio/transcriptions",[366,489,490,495],{},[381,491,492],{},[127,493,494],{},"ASSISTANT_TRANSCRIPTION_MODEL",[381,496,497,498,402],{},"Transcription model name. (Default: ",[127,499,500],{},"gpt-4o-mini-transcribe",[366,502,503,508],{},[381,504,505],{},[127,506,507],{},"ASSISTANT_TRANSCRIPTION_API_KEY",[381,509,510],{},"API key for the transcription endpoint.",[287,512,514],{"id":513},"docker-image-flavors","Docker image flavors",[265,516,517,523],{},[268,518,519,522],{},[127,520,521],{},":latest"," - Stable, less frequent updates",[268,524,525,528],{},[127,526,527],{},":dev"," - Latest features, more updates, still stable.",[530,531],"hr",{},[102,533,535],{"id":534},"post-install-configuration","Post-install Configuration",[537,538,539,562],"ol",{},[268,540,541,544,545,547,548,551,552,551,555,551,558,561],{},[111,542,543],{},"Generate Firefly III Auth Token:"," Open up ",[111,546,113],{}," and finish the onboarding process if this is your first usage. **** Go to ",[127,549,550],{},"Options"," -> ",[127,553,554],{},"Profile",[127,556,557],{},"OAuth",[127,559,560],{},"Create New Personal Access Token",".",[268,563,564,567,568,570,571,551,574,577],{},[111,565,566],{},"Connect Pico:"," Open ",[111,569,117],{},", **** go to ",[127,572,573],{},"Settings",[127,575,576],{},"Setup"," and paste the token.",[240,579,580,581,584,585,587],{},"In most scenarios you don't need to change the ",[246,582,583],{},"Pico Backend URL"," field!!! This is helpful only if deploy the ",[111,586,117],{}," backend somewhere separate from the frontend.",[589,590,591],"style",{},"html pre.shiki code .swJcz, html code.shiki .swJcz{--shiki-light:#E53935;--shiki-default:#F07178;--shiki-dark:#F07178}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);