[88,92],{"title":89,"path":90,"stem":91},"Architecture","/about/architecture","6.about/0.architecture",{"title":93,"path":94,"stem":95},"Attribution","/about/attribution","6.about/1.attribution",{"id":97,"title":16,"body":98,"description":739,"extension":740,"links":741,"meta":742,"navigation":743,"path":17,"seo":744,"stem":18,"__hash__":745},"docs/1.installation/1.docker.md",{"type":99,"value":100,"toc":730},"minimark",[101,105,110,123,250,282,297,302,305,316,322,367,378,382,475,479,489,620,624,638,641,645,700,710,726],[102,103,11],"h1",{"id":104},"installation",[106,107,109],"h2",{"id":108},"docker-recommended","Docker (Recommended)",[111,112,113,114,118,119,122],"p",{},"If you already have ",[115,116,117],"strong",{},"Firefly III"," installed the fastest way to get started with ",[115,120,121],{},"Firefly-Pico"," is via docker-compose.",[124,125,130],"pre",{"className":126,"code":127,"language":128,"meta":129,"style":129},"language-yaml shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","version: '3.3'\nservices:\n  firefly-pico:\n    image: cioraneanu/firefly-pico:latest\n    ports:\n      - \"6976:80\"\n    environment:\n      - FIREFLY_URL=https://firefly.domain.com\n    volumes:\n      - /path/firefly-pico-data:/var/www/html/database/data\n    restart: unless-stopped\n","yaml","",[131,132,133,156,165,173,184,192,207,215,223,231,239],"code",{"__ignoreMap":129},[134,135,138,142,146,149,153],"span",{"class":136,"line":137},"line",1,[134,139,141],{"class":140},"swJcz","version",[134,143,145],{"class":144},"sMK4o",":",[134,147,148],{"class":144}," '",[134,150,152],{"class":151},"sfazB","3.3",[134,154,155],{"class":144},"'\n",[134,157,159,162],{"class":136,"line":158},2,[134,160,161],{"class":140},"services",[134,163,164],{"class":144},":\n",[134,166,168,171],{"class":136,"line":167},3,[134,169,170],{"class":140},"  firefly-pico",[134,172,164],{"class":144},[134,174,176,179,181],{"class":136,"line":175},4,[134,177,178],{"class":140},"    image",[134,180,145],{"class":144},[134,182,183],{"class":151}," cioraneanu/firefly-pico:latest\n",[134,185,187,190],{"class":136,"line":186},5,[134,188,189],{"class":140},"    ports",[134,191,164],{"class":144},[134,193,195,198,201,204],{"class":136,"line":194},6,[134,196,197],{"class":144},"      -",[134,199,200],{"class":144}," \"",[134,202,203],{"class":151},"6976:80",[134,205,206],{"class":144},"\"\n",[134,208,210,213],{"class":136,"line":209},7,[134,211,212],{"class":140},"    environment",[134,214,164],{"class":144},[134,216,218,220],{"class":136,"line":217},8,[134,219,197],{"class":144},[134,221,222],{"class":151}," FIREFLY_URL=https://firefly.domain.com\n",[134,224,226,229],{"class":136,"line":225},9,[134,227,228],{"class":140},"    volumes",[134,230,164],{"class":144},[134,232,234,236],{"class":136,"line":233},10,[134,235,197],{"class":144},[134,237,238],{"class":151}," /path/firefly-pico-data:/var/www/html/database/data\n",[134,240,242,245,247],{"class":136,"line":241},11,[134,243,244],{"class":140},"    restart",[134,246,145],{"class":144},[134,248,249],{"class":151}," unless-stopped\n",[251,252,253,275],"note",{},[111,254,255,256,260,261,263,264,267,268,271,272],{},"Make sure the environment variable ",[257,258,259],"u",{},"FIREFLY_URL"," points to your ",[115,262,117],{}," instance. This can be either IP + Port (ex. ",[131,265,266],{},"http://192.168.1.99:8080",") or subdomain (ex. ",[131,269,270],{},"https://firefly.domain.com",") if you use a reverse proxy like Nginx Proxy Manager.\n",[273,274],"br",{},[276,277,278],"ul",{},[279,280,281],"li",{},"Set the volume to a persistent folder for the SQLite database.",[276,283,284,295],{},[279,285,255,286,260,288,263,290,267,292,294],{},[115,287,259],{},[115,289,117],{},[131,291,266],{},[131,293,270],{},") if you use a reverse proxy like Nginx Proxy Manager.",[279,296,281],{},[298,299,301],"h3",{"id":300},"other-variants","Other variants:",[111,303,304],{},"If you prefer PostgreSQL over SQLite for Pico's own database:",[276,306,307],{},[279,308,309],{},[310,311,315],"a",{"href":312,"rel":313},"https://github.com/cioraneanu/firefly-pico/blob/main/docker-compose.pico.yml",[314],"nofollow","Pico + PostgreSQL",[111,317,318,319,321],{},"If you don't yet have ",[115,320,117],{}," installed and want both inside a single Docker-compose file:",[276,323,324,331],{},[279,325,326],{},[310,327,330],{"href":328,"rel":329},"https://github.com/cioraneanu/firefly-pico/blob/main/docker-compose.pico+firefly.yml",[314],"Pico + Firefly",[279,332,333,338],{},[310,334,337],{"href":335,"rel":336},"https://github.com/cioraneanu/firefly-pico/blob/main/docker-compose.pico+firefly+importer.yml",[314],"Pico + Firefly + Importer",[276,339,340,353],{},[279,341,342,343,345,346,345,349,352],{},"Update ",[131,344,259],{}," / ",[131,347,348],{},"APP_URL",[131,350,351],{},"FIREFLY_III_URL"," accordingly.",[279,354,355,356,359,360,363,364],{},"Change ",[131,357,358],{},"DB_PASSWORD"," and ",[131,361,362],{},"POSTGRES_PASSWORD"," to something secure. ",[115,365,366],{},"Make sure they match!",[111,368,369,370,372,373],{},"Further information on how to setup and configure ",[115,371,117],{}," can be found on their officials docs: ",[310,374,377],{"href":375,"rel":376},"https://docs.firefly-iii.org/how-to/firefly-iii/installation/docker/",[314],"HERE",[298,379,381],{"id":380},"environment-variables","Environment Variables",[383,384,385,398],"table",{},[386,387,388],"thead",{},[389,390,391,395],"tr",{},[392,393,394],"th",{},"Name",[392,396,397],{},"Description",[399,400,401,412,426,440,458],"tbody",{},[389,402,403,409],{},[404,405,406],"td",{},[131,407,408],{},"NUXT_PUBLIC_QUERY_TIMEOUT",[404,410,411],{},"Milliseconds Pico should wait before a request times out. (Default: 8000)",[389,413,414,419],{},[404,415,416],{},[131,417,418],{},"TZ",[404,420,421,422,425],{},"Pico backend Timezone (ex. ",[131,423,424],{},"Europe/London",")",[389,427,428,433],{},[404,429,430],{},[131,431,432],{},"APP_KEY",[404,434,435,436,439],{},"Encrypts the assistant API keys users save in Pico. Must be 32 characters (or ",[131,437,438],{},"base64:"," + 32 bytes). If unset, one is generated on the first start and kept in the data volume.",[389,441,442,447],{},[404,443,444],{},[131,445,446],{},"NGINX_PORT",[404,448,449,450,453,454,457],{},"Internal port of the container. (Default: 80) Set it to ",[131,451,452],{},"8080"," and map ",[131,455,456],{},"6976:8080"," on hosts that don't allow binding port 80 (ex. Synology Container Manager).",[389,459,460,465],{},[404,461,462],{},[131,463,464],{},"CUSTOM_ICONS_PATH",[404,466,467,468,471,472,425],{},"Folder for your own ",[310,469,470],{"href":52},"custom icons",". (Default: ",[131,473,474],{},"storage/app/custom-icons",[298,476,478],{"id":477},"optional-environment-variables","Optional Environment Variables",[111,480,481,482,484,485,488],{},"These power the AI features of ",[310,483,55],{"href":56}," for all users of the instance. Leave them unset and Pico works exactly as before; each user can still add their own LLM connection in ",[131,486,487],{},"Settings -> Assistant",".",[383,490,491,499],{},[386,492,493],{},[389,494,495,497],{},[392,496,394],{},[392,498,397],{},[399,500,501,516,529,539,549,562,575,585,603],{},[389,502,503,508],{},[404,504,505],{},[131,506,507],{},"ASSISTANT_LLM_ENDPOINT",[404,509,510,511,471,513,425],{},"OpenAI-compatible chat completions endpoint used by ",[310,512,55],{"href":56},[131,514,515],{},"https://api.openai.com/v1/chat/completions",[389,517,518,523],{},[404,519,520],{},[131,521,522],{},"ASSISTANT_LLM_MODEL",[404,524,525,526,425],{},"LLM model name. (Default: ",[131,527,528],{},"gpt-4o-mini",[389,530,531,536],{},[404,532,533],{},[131,534,535],{},"ASSISTANT_LLM_API_KEY",[404,537,538],{},"API key for the LLM endpoint.",[389,540,541,546],{},[404,542,543],{},[131,544,545],{},"ASSISTANT_LLM_CONTEXT",[404,547,548],{},"Extra instructions appended to every Ramble interpretation.",[389,550,551,556],{},[404,552,553],{},[131,554,555],{},"ASSISTANT_TRANSCRIPTION_ENDPOINT",[404,557,558,559,425],{},"OpenAI-compatible audio transcription endpoint for voice rambles. (Default: ",[131,560,561],{},"https://api.openai.com/v1/audio/transcriptions",[389,563,564,569],{},[404,565,566],{},[131,567,568],{},"ASSISTANT_TRANSCRIPTION_MODEL",[404,570,571,572,425],{},"Transcription model name. (Default: ",[131,573,574],{},"gpt-4o-mini-transcribe",[389,576,577,582],{},[404,578,579],{},[131,580,581],{},"ASSISTANT_TRANSCRIPTION_API_KEY",[404,583,584],{},"API key for the transcription endpoint.",[389,586,587,592],{},[404,588,589],{},[131,590,591],{},"ASSISTANT_TRANSCRIPTION_LANGUAGE",[404,593,594,595,598,599,602],{},"Optional language hint for transcription (ex. ",[131,596,597],{},"en",", ",[131,600,601],{},"ro",").",[389,604,605,610],{},[404,606,607],{},[131,608,609],{},"ASSISTANT_ALLOW_PRIVATE_ENDPOINTS",[404,611,612,613,616,617,425],{},"Set to ",[131,614,615],{},"true"," to let users point their own connections at hosts on your local network (ex. Ollama). (Default: ",[131,618,619],{},"false",[298,621,623],{"id":622},"docker-image-flavors","Docker image flavors",[276,625,626,632],{},[279,627,628,631],{},[131,629,630],{},":latest"," - Stable, less frequent updates",[279,633,634,637],{},[131,635,636],{},":dev"," - Latest features, more updates, still stable.",[639,640],"hr",{},[106,642,644],{"id":643},"post-install-configuration","Post-install Configuration",[646,647,648,670],"ol",{},[279,649,650,653,654,656,657,660,661,660,664,660,667,488],{},[115,651,652],{},"Generate Firefly III Auth Token:"," Open up ",[115,655,117],{}," and finish the onboarding process if this is your first usage. **** Go to ",[131,658,659],{},"Options"," -> ",[131,662,663],{},"Profile",[131,665,666],{},"OAuth",[131,668,669],{},"Create New Personal Access Token",[279,671,672,675,676,678,679,660,682,685,686,660,688,691,692,695,696,699],{},[115,673,674],{},"Connect Pico:"," Open ",[115,677,121],{},", **** go to ",[131,680,681],{},"Settings",[131,683,684],{},"Setup"," (on desktop ",[131,687,681],{},[131,689,690],{},"Connection & data","), paste the token in ",[131,693,694],{},"Personal access token"," and use ",[131,697,698],{},"Test connection"," to check it.",[251,701,702,703,706,707,709],{},"In most scenarios you don't need to change the ",[257,704,705],{},"Pico Backend URL"," field!!! This is helpful only if deploy the ",[115,708,121],{}," backend somewhere separate from the frontend.",[711,712,713,714,717,718,721,722,725],"tip",{},"Just want to look around first? Use ",[131,715,716],{},"Try with sample data"," on the same page. ",[115,719,720],{},"Demo mode"," runs entirely on your device with sample data, no server needed. ",[131,723,724],{},"Exit demo mode"," deletes the sample data and resets the app.",[727,728,729],"style",{},"html pre.shiki code .swJcz, html code.shiki .swJcz{--shiki-light:#E53935;--shiki-default:#F07178;--shiki-dark:#F07178}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-