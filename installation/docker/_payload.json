co/blob/main/docker-compose.pico+firefly.yml",[310],"nofollow","Pico + Firefly",[272,313,314,319],{},[306,315,318],{"href":316,"rel":317},"https://github.com/cioraneanu/firefly-pico/blob/main/docker-compose.pico+firefly+importer.yml",[310],"Pico + Firefly + Importer",[269,320,321,334],{},[272,322,323,324,326,327,326,330,333],{},"Update ",[131,325,252],{}," / ",[131,328,329],{},"APP_URL",[131,331,332],{},"FIREFLY_III_URL"," accordingly.",[272,335,336,337,340,341,344,345],{},"Change ",[131,338,339],{},"DB_PASSWORD"," and ",[131,342,343],{},"POSTGRES_PASSWORD"," to something secure. ",[115,346,347],{},"Make sure they match!",[111,349,350,351,353,354],{},"Further information on how to setup and configure ",[115,352,117],{}," can be found on their officials docs: ",[306,355,358],{"href":356,"rel":357},"https://docs.firefly-iii.org/how-to/firefly-iii/installation/docker/",[310],"HERE",[291,360,362],{"id":361},"environment-variables","Environment Variables",[364,365,366,379],"table",{},[367,368,369],"thead",{},[370,371,372,376],"tr",{},[373,374,375],"th",{},"Name",[373,377,378],{},"Description",[380,381,382,393],"tbody",{},[370,383,384,390],{},[385,386,387],"td",{},[131,388,389],{},"NUXT_PUBLIC_QUERY_TIMEOUT",[385,391,392],{},"Milliseconds Pico should wait before a request times out. (Default: 4000)",[370,394,395,400],{},[385,396,397],{},[131,398,399],{},"TZ",[385,401,402,403,406],{},"Pico backend Timezone (ex. ",[131,404,405],{},"Europe/London",")",[291,408,410],{"id":409},"optional-environment-variables","Optional Environment Variables",[111,412,413,414,417],{},"These power the AI features of ",[306,415,46],{"href":416},"/features/ramble",". Leave them unset and Pico works exactly as before.",[364,419,420,428],{},[367,421,422],{},[370,423,424,426],{},[373,425,375],{},[373,427,378],{},[380,429,430,446,459,469,479,492,505],{},[370,431,432,437],{},[385,433,434],{},[131,435,436],{},"ASSISTANT_LLM_ENDPOINT",[385,438,439,440,442,443,406],{},"OpenAI-compatible chat completions 