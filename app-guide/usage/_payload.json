[{"data":1,"prerenderedAt":347},["ShallowReactive",2],{"navigation_docs":3,"-app-guide-usage":96,"-app-guide-usage-surround":343},[4,10,24,33,54,73,83],{"title":5,"path":6,"stem":7,"children":8},"Introduction","/introduction","0.introduction/index",[9],{"title":5,"path":6,"stem":7},{"title":11,"path":12,"stem":13,"children":14,"page":23},"Installation","/installation","1.installation",[15,19],{"title":16,"path":17,"stem":18},"Docker","/installation/docker","1.installation/1.docker",{"title":20,"path":21,"stem":22},"From source","/installation/manual","1.installation/2.manual",false,{"title":25,"path":26,"stem":27,"children":28,"page":23},"App guide","/app-guide","2.app-guide",[29],{"title":30,"path":31,"stem":32},"App usage","/app-guide/usage","2.app-guide/1.usage",{"title":34,"path":35,"stem":36,"children":37,"page":23},"Features","/features","3.features",[38,42,46,50],{"title":39,"path":40,"stem":41},"Templates","/features/templates","3.features/1.templates",{"title":43,"path":44,"stem":45},"Assistant","/features/assistant","3.features/2.assistant",{"title":47,"path":48,"stem":49},"Profiles","/features/profiles","3.features/4.profiles",{"title":51,"path":52,"stem":53},"Custom icons","/features/custom-icons","3.features/5.custom-icons",{"title":55,"path":56,"stem":57,"children":58},"Ramble","/ramble","4.ramble",[59,61,65,69],{"title":55,"path":56,"stem":60},"4.ramble/index",{"title":62,"path":63,"stem":64},"Install and configure","/ramble/configuration","4.ramble/1.configuration",{"title":66,"path":67,"stem":68},"Ramble API","/ramble/api","4.ramble/2.api",{"title":70,"path":71,"stem":72},"iOS Shortcuts","/ramble/ios","4.ramble/3.ios",{"title":74,"path":75,"stem":76,"children":77},"Contributing","/contribute","5.contribute/1.index",[78,79],{"title":74,"path":75,"stem":76},{"title":80,"path":81,"stem":82},"Localization","/contribute/localization","5.contribute/2.localization",{"title":84,"path":85,"stem":86,"children":87,"page":23},"About","/about","6.about",[88,92],{"title":89,"path":90,"stem":91},"Architecture","/about/architecture","6.about/0.architecture",{"title":93,"path":94,"stem":95},"Attribution","/about/attribution","6.about/1.attribution",{"id":97,"title":30,"body":98,"description":334,"extension":335,"links":336,"meta":337,"navigation":338,"path":31,"seo":339,"stem":32,"__hash__":342},"docs/2.app-guide/1.usage.md",{"type":99,"value":100,"toc":325},"minimark",[101,109,114,239,243,256,265,268,272,302,309,313,316],[102,103,104,108],"p",{},[105,106,107],"strong",{},"Firefly III"," is very flexible and that can leave people unsure about how they should organise things. By no means is this the only way to do, but here's my opinionated guide:",[110,111,113],"h3",{"id":112},"daily-usage","Daily usage",[115,116,117,125,136,143,161,186,205,211,225,236],"ul",{},[118,119,120,121,124],"li",{},"Create ",[105,122,123],{},"asset"," accounts for everything: one for every family member, one for your savings, stocks broker etc.",[118,126,127,128,131,132,135],{},"Don't create any ",[105,129,130],{},"revenue"," or ",[105,133,134],{},"expense"," accounts; that way they will be treated as \"cash\" and you'll have one less field to fill inside transactions",[118,137,138,139,142],{},"Create your big, general ",[105,140,141],{},"categories",": ex. Bills, Food, Fun, Transportation etc.",[118,144,145,146,149,150,152,153,156,157,160],{},"Create your root ",[105,147,148],{},"tags"," with names identical to the ",[105,151,141],{}," above. This enables auto-selection of a ",[105,154,155],{},"tag"," when you pick a ",[105,158,159],{},"category"," and vice-versa.",[118,162,163,164,166,167,171,172,171,175,178,179,181,182,185],{},"Create your child ",[105,165,148],{}," for granularity (ex. ",[168,169,170],"em",{},"Electricity",", ",[168,173,174],{},"Heating",[168,176,177],{},"Internet"," all under the parent ",[105,180,155],{}," ",[168,183,184],{},"Bills","). It's a good idea to remember these names and use them with the assistant for super fast expense tracking",[118,187,188,189,191,192,195,196,200,201,204],{},"Create a ",[105,190,155],{},", name it \"",[168,193,194],{},"todo","\", and set the ",[197,198,199],"code",{},"Mark as to-do"," field to Yes. Attach this tag to any transaction that needs later editing. Ex. You paid dinner for multiple people and some will give you the money back later. Or you buy multiple shoes and return some of them. All these transactions will show up on your ",[105,202,203],{},"Dashboard",".",[118,206,207,208],{},"Set the usual account from which you make payments in ",[197,209,210],{},"Settings -> Transactions -> Default form values -> Default source account",[118,212,213,214,216,217,220,221,224],{},"Inside ",[105,215,107],{}," create ",[105,218,219],{},"recurring transactions","for all your subscriptions and transactions that repeat at fixed intervals [These are not yet implemented inside ",[105,222,223],{},"Firefly-Pico","]",[118,226,227,228,231,232,235],{},"Identify any transactions that you perform regularly but cannot be turned into ",[105,229,230],{},"Repeating transactions"," because of irregularities. Create ",[105,233,234],{},"templates"," for them. The assistant can easily handle them as well.",[118,237,238],{},"For budgets you can setup \"Rules\" inside Firefly III. When a transaction is created, if it has a list of tags, asign it to your desiered budget.",[110,240,242],{"id":241},"split-transactions","Split transactions",[102,244,245,246,248,249,252,253,204],{},"In ",[105,247,107],{}," you can create ",[168,250,251],{},"split transactions",": one transaction with multiple parts. Although useful for some\nusers, I would advise against using them. They add another level of complexity and don't work with the assistant.\nMy recommendation is to keep things simple and just create ",[105,254,255],{},"N separate transactions",[102,257,258,259,171,262,204],{},"If you want to mark them as a \"group\" you can use matching descriptions like: ",[197,260,261],{},"lidl - pet food",[197,263,264],{},"lidl - groceries",[102,266,267],{},"Although Pico doesn't allow the creation of split-transactions, you can always create them in Firefly III and see them as\nreadonly in Pico.",[110,269,271],{"id":270},"on-vacation","On vacation:",[115,273,274,280,286,293],{},[118,275,276,277,279],{},"Create a new ",[105,278,155],{}," \"vacation germany 2026\" under a root tag \"vacation\".",[118,281,276,282,285],{},[105,283,284],{},"profile"," called \"vacation\"",[118,287,288,289,292],{},"Configure ",[197,290,291],{},"Settings -> Transactions -> Default form values"," to use the foreign currency \"Euro\" and default tag \"vacation germany 2026\"",[118,294,288,295,298,299,301],{},[197,296,297],{},"Settings -> Assistant -> Currency"," to \"Euro\"\nThis way you can still use the assitant to create new transactions, write the amount in the actual local currency and have the \"vacation germany 2026\" ",[105,300,155],{}," added automatically so you can check your total spending when you get back.",[102,303,304,305,308],{},"Example: In assistant ",[197,306,307],{},"museum 50"," -> means 50 Euros",[110,310,312],{"id":311},"mobile-device","Mobile device.",[102,314,315],{},"Finally make the process of starting the app faster by installing the PWA:",[115,317,318],{},[118,319,320,324],{},[321,322,323],"span",{},"iOS"," open the app in Safari -> Share -> Add to Homescreen. The app will also show up in you iOS global search",{"title":326,"searchDepth":327,"depth":327,"links":328},"",2,[329,331,332,333],{"id":112,"depth":330,"text":113},3,{"id":241,"depth":330,"text":242},{"id":270,"depth":330,"text":271},{"id":311,"depth":330,"text":312},"Get the most out of Firefly Pico with this daily workflow.","md",null,{},true,{"title":340,"description":341},"Guide","My highly opinionated setup.","MIBm6Np9rrrPvoFvCU_D3ksi6wU0SE8OLIKN9N9eaV8",[344,346],{"title":20,"path":21,"stem":22,"description":345,"children":-1},"Manually build it",{"title":39,"path":40,"stem":41,"description":336,"children":-1},1794377408893]