stem":91},"Attribution","/about/attribution","6.about/1.attribution",{"id":93,"title":85,"body":94,"description":311,"extension":312,"links":313,"meta":314,"navigation":315,"path":86,"seo":316,"stem":87,"__hash__":317},"docs/6.about/0.architecture.md",{"type":95,"value":96,"toc":298},"minimark",[97,102,111,144,148,158,180,185,191,205,209,214,243,249,253,286,289],[98,99,101],"h2",{"id":100},"frontend-the-app","Frontend (The App)",[103,104,105,106,110],"p",{},"Found inside the ",[107,108,109],"code",{},"/front"," folder, it is a Single Page Application (SPA) built with:",[112,113,114,128,138],"ul",{},[115,116,117,127],"li",{},[118,119,120],"strong",{},[121,122,126],"a",{"href":123,"rel":124},"https://nuxt.com/",[125],"nofollow","Nuxt",": A powerful Vue.js framework that provides the application structure and routing.",[115,129,130,137],{},[118,131,132],{},[121,133,136],{"href":134,"rel":135},"https://vant-ui.github.io",[125],"Vant UI",": A lightweight Mobile UI Component library that gives Pico its native app feel.",[115,139,140,143],{},[118,141,142],{},"PWA"," (Progressive Web App): Allows the app to be installed on your device, work offline (to an extent), and launch like a native app.",[98,145,147],{"id":146},"backend-the-brains","Backend (The Brains)",[103,149,105,150,153,154,157],{},[107,151,152],{},"/back"," folder it exposes a REST API and proxies all requests to your ",[118,155,156],{},"Firefly III"," instance.",[112,159,160,170],{},[115,161,162,169],{},[118,163,164],{},[121,165,168],{"href":166,"rel":167},"https://laravel.com/",[125],"Laravel",": A robust PHP framework used for the REST API.",[115,171,172,179],{},[118,173,174],{},[121,175,178],{"href":176,"rel":177},"https://github.com/spatie/laravel-query-builder",[125],"Spatie Query Builder"," for implementing the JSON:API specification",[181,182,184],"h3",{"id":183},"database","Database",[103,186,187,190],{},[118,188,189],{},"Firefly-Pico"," maintains a separate, lightweight database to store:",[112,192,193,199],{},[115,194,195,198],{},[118,196,197],{},"Icons:"," Linked to Firefly resources (accounts, categories).",[115,200,201,204],{},[118,202,203],{},"Metadata:"," Extra columns not supported by Firefly III.",[98,206,208],{"id":207},"security","Security",[103,210,211,213],{},[118,212,189],{}," does not implement a separate authorization layer!",[112,215,216,222,227,237],{},[115,217,218,219,221],{},"It proxies all requests to the ",[118,220,156],{}," API.",[115,223,224,226],{},[118,225,156],{}," is responsible for checking the Authorization header.",[115,228,229,230,232,233,236],{},"Even custom endpoints (like /api/transaction-templates) are authorized by against ",[118,231,156],{},"'s ",[107,234,235],{},"v1/about/user"," endpoint first.",[115,238,239,242],{},[118,240,241],{},"Benefit:"," Single source of truth for authorization; no separate account needed.",[103,244,245],{},[246,247],"img",{"alt":85,"src":248},"/images/architecture.png",[181,250,252],{"id":251},"data-storage","Data Storage",[112,254,255,265],{},[115,256,257,260,261,264],{},[118,258,259],{},"Local Storage:"," App settings, tags, accounts, categories, budgets, and templates are cached in the browser's ",[107,262,263],{},"localStorage"," for instant access.",[115,266,267,270,271,274,275,278,279,278,282,285],{},[118,268,269],{},"Syncing:"," Data is re-synced every ",[107,272,273],{},"N days"," (configurable). You can manually trigger a sync via ",[107,276,277],{},"Settings"," -> ",[107,280,281],{},"App config",[107,283,284],{},"Save"," or by pulling to refresh on lists.",[98,287,16],{"id":288},"docker",[112,290,291],{},[115,292,293,294,297],{},"exposes a single port to the outside. Inside the container there is an Nginx instance which sends all requests containing ",[107,295,296],{},"/api"," to the backend and all other to the frontend instance.",{"title":299,"searchDepth":300,"depth":300,"links":301},"",2,[302,303,307,310],{"id":100,"depth":300,"text":101},{"id":146,"depth":300,"text":147,"children":304},[305],{"id":183,"depth":306,"text":184},3,{"id":207,"depth":300,"text":208,"children":308},[309],{"id":251,"depth":306,"text":252},{"id":288,"depth":300,"text":16},"Understand how Firefly Pico works under the hood.","md",null,{},true,{"title":85,"description":311},"FMI1CbC01zEZ2c7kooxV-0JW8FBbXR_mgX3oinm9qLY",[319,321],{"title":76,"path":77,"stem":78,"description":320,"children":-1},"Steps to add support for a new language",{"title":89,"path":90,"stem":91,"description":322,"children":-1},"Just like Firefly III this is licensed under the GNU Affero General Public License v3.",1785485816576]