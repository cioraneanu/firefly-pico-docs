8,92],{"title":89,"path":90,"stem":91},"Architecture","/about/architecture","6.about/0.architecture",{"title":93,"path":94,"stem":95},"Attribution","/about/attribution","6.about/1.attribution",{"id":97,"title":89,"body":98,"description":383,"extension":384,"links":385,"meta":386,"navigation":387,"path":90,"seo":388,"stem":91,"__hash__":389},"docs/6.about/0.architecture.md",{"type":99,"value":100,"toc":370},"minimark",[101,106,115,175,179,189,211,216,222,263,267,272,301,307,311,341,344],[102,103,105],"h2",{"id":104},"frontend-the-app","Frontend (The App)",[107,108,109,110,114],"p",{},"Found inside the ",[111,112,113],"code",{},"/front"," folder, it is a Single Page Application (SPA) built with:",[116,117,118,132,138,156,162],"ul",{},[119,120,121,131],"li",{},[122,123,124],"strong",{},[125,126,130],"a",{"href":127,"rel":128},"https://nuxt.com/",[129],"nofollow","Nuxt",": A powerful Vue.js framework that provides the application structure and routing.",[119,133,134,137],{},[122,135,136],{},"Two interfaces",": a mobile app built on a home-grown UI kit that gives Pico its native app feel, and a dedicated desktop app. Pico picks one on startup based on your screen (or your choice in Settings).",[119,139,140,147,148,155],{},[122,141,142],{},[125,143,146],{"href":144,"rel":145},"https://tailwindcss.com/",[129],"Tailwind CSS"," and ",[122,149,150],{},[125,151,154],{"href":152,"rel":153},"https://pinia.vuejs.org/",[129],"Pinia"," for styling and state.",[119,157,158,161],{},[122,159,160],{},"PWA"," (Progressive Web App): Allows the app to be installed on your device, load offline, and launch like a native app.",[119,163,164,167,168,171,172,174],{},[122,165,166],{},"iOS app"," (inside ",[111,169,170],{},"/ios","): a native wrapper around the same web app that adds native voice recording for ",[125,173,55],{"href":56},".",[102,176,178],{"id":177},"backend-the-brains","Backend (The Brains)",[107,180,109,181,184,185,188],{},[111,182,183],{},"/back"," folder it exposes a REST API and proxies all requests to your ",[122,186,187],{},"Firefly III"," instance.",[116,190,191,201],{},[119,192,193,200],{},[122,194,195],{},[125,196,199],{"href":197,"rel":198},"https://laravel.com/",[129],"Laravel",": A robust PHP framework used for the REST API.",[119,202,203,210],{},[122,204,205],{},[125,206,209],{"href":207,"rel":208},"https://github.com/spatie/laravel-query-builder",[129],"Spatie Query Builder"," for implementing the JSON:API specification",[212,213,215],"h3",{"id":214},"database","Database",[107,217,218,221],{},[122,219,220],{},"Firefly-Pico"," maintains a separate, lightweight database to store:",[116,223,224,230,244,251,257],{},[119,225,226,229],{},[122,227,228],{},"Icons:"," Linked to Firefly resources (accounts, categories, tags, budgets etc).",[119,231,232,235,236,239,240,243],{},[122,233,234],{},"Metadata:"," Extra columns not supported by Firefly III (ex. parent ",[122,237,238],{},"tags",", the todo ",[122,241,242],{},"tag",").",[119,245,246,147,248,250],{},[122,247,39],{},[122,249,47],{}," (settings synced via your token).",[119,252,253,256],{},[122,254,255],{},"Rambles:"," Saved texts and voice recordings waiting to be interpreted.",[119,258,259,262],{},[122,260,261],{},"Assistant connections:"," Each user's own LLM / transcription settings, with the API keys encrypted.",[102,264,266],{"id":265},"security","Security",[107,268,269,271],{},[122,270,220],{}," does not implement a separate authorization layer!",[116,273,274,280,285,295],{},[119,275,276,277,279],{},"It proxies all requests to the ",[122,278,187],{}," API.",[119,281,282,284],{},[122,283,187],{}," is responsible for checking the Authorization header.",[119,286,287,288,290,291,294],{},"Even custom endpoints (like /api/transaction-templates) are authorized by against ",[122,289,187],{},"'s ",[111,292,293],{},"v1/about/user"," endpoint first.",[119,296,297,300],{},[122,298,299],{},"Benefit:"," Single source of truth for authorization; no separate account needed.",[107,302,303],{},[304,305],"img",{"alt":89,"src":306},"/images/architecture.png",[212,308,310],{"id":309},"data-storage","Data Storage",[116,312,313,323],{},[119,314,315,318,319,322],{},[122,316,317],{},"Local Storage:"," App settings, tags, accounts, categories, budgets, and templates are cached in the browser's ",[111,320,321],{},"localStorage"," for instant access.",[119,324,325,328,329,332,333,336,337,340],{},[122,326,327],{},"Syncing:"," Data is re-synced every ",[111,330,331],{},"N days"," (configurable). You can manually trigger a sync via ",[111,334,335],{},"Settings"," -> ",[111,338,339],{},"Sync everything"," on mobile, the sync button in the sidebar on desktop, or by pulling to refresh on lists.",[102,342,16],{"id":343},"docker",[116,345,346,353,363],{},[119,347,348,349,352],{},"exposes a single port to the outside. Inside the container there is an Nginx instance which sends all requests containing ",[111,350,351],{},"/api"," to the backend and all other to the frontend instance.",[119,354,355,356,359,360,243],{},"Pico's database is SQLite by default (inside the data volume), but PostgreSQL is also supported via the ",[111,357,358],{},"DB_*"," variables (see ",[111,361,362],{},"docker-compose.pico.yml",[119,364,365,366,369],{},"The data volume also keeps the generated ",[111,367,368],{},"APP_KEY",", used to encrypt the assistant API keys.",{"title":371,"searchDepth":372,"depth":372,"links":373},"",2,[374,375,379,382],{"id":104,"depth":372,"text":105},{"id":177,"depth":372,"text":178,"children":376},[377],{"id":214,"depth":378,"text":215},3,{"id":265,"depth":372,"text":266,"children":380},[381],{"id":309,"depth":378,"text":310},{"id":343,"depth":372,"text":16},"Understand how Firefly Pico works under the hood.","md",null,{},true,{"title":89,"description":383},"So-O5WvOyZP7i2cAgIXMcHW_uCdQkEJb9T63V-lMTno",[391,393],{"title":80,"path":81,"stem":82,"description":392,"children":-1},"Steps to add support for a new language",{"title":93,"path":94,"stem":95,"description":394,"children":-1},"Just like Firefly III this is licensed under the GNU Affero General Public License v3.",1795175690375]