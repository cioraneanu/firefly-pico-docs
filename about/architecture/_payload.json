ath":90,"stem":91},"Architecture","/about/architecture","6.about/0.architecture",{"title":93,"path":94,"stem":95},"Attribution","/about/attribution","6.about/1.attribution",{"id":97,"title":89,"body":98,"description":315,"extension":316,"links":317,"meta":318,"navigation":319,"path":90,"seo":320,"stem":91,"__hash__":321},"docs/6.about/0.architecture.md",{"type":99,"value":100,"toc":302},"minimark",[101,106,115,148,152,162,184,189,195,209,213,218,247,253,257,290,293],[102,103,105],"h2",{"id":104},"frontend-the-app","Frontend (The App)",[107,108,109,110,114],"p",{},"Found inside the ",[111,112,113],"code",{},"/front"," folder, it is a Single Page Application (SPA) built with:",[116,117,118,132,142],"ul",{},[119,120,121,131],"li",{},[122,123,124],"strong",{},[125,126,130],"a",{"href":127,"rel":128},"https://nuxt.com/",[129],"nofollow","Nuxt",": A powerful Vue.js framework that provides the application structure and routing.",[119,133,134,141],{},[122,135,136],{},[125,137,140],{"href":138,"rel":139},"https://vant-ui.github.io",[129],"Vant UI",": A lightweight Mobile UI Component library that gives Pico its native app feel.",[119,143,144,147],{},[122,145,146],{},"PWA"," (Progressive Web App): Allows the app to be installed on your device, work offline (to an extent), and launch like a native app.",[102,149,151],{"id":150},"backend-the-brains","Backend (The Brains)",[107,153,109,154,157,158,161],{},[111,155,156],{},"/back"," folder it exposes a REST API and proxies all requests to your ",[122,159,160],{},"Firefly III"," instance.",[116,163,164,174],{},[119,165,166,173],{},[122,167,168],{},[125,169,172],{"href":170,"rel":171},"https://laravel.com/",[129],"Laravel",": A robust PHP framework used for the REST API.",[119,175,176,183],{},[122,177,178],{},[125,179,182],{"href":180,"rel":181},"https://github.com/spatie/laravel-query-builder",[129],"Spatie Query Builder"," for implementing the JSON:API specification",[185,186,188],"h3",{"id":187},"database","Database",[107,190,191,194],{},[122,192,193],{},"Firefly-Pico"," maintains a separate, lightweight database to store:",[116,196,197,203],{},[119,198,199,202],{},[122,200,201],{},"Icons:"," Linked to Firefly resources (accounts, categories).",[119,204,205,208],{},[122,206,207],{},"Metadata:"," Extra columns not supported by Firefly III.",[102,210,212],{"id":211},"security","Security",[107,214,215,217],{},[122,216,193],{}," does not implement a separate authorization layer!",[116,219,220,226,231,241],{},[119,221,222,223,225],{},"It proxies all requests to the ",[122,224,160],{}," API.",[119,227,228,230],{},[122,229,160],{}," is responsible for checking the Authorization header.",[119,232,233,234,236,237,240],{},"Even custom endpoints (like /api/transaction-templates) are authorized by against ",[122,235,160],{},"'s ",[111,238,239],{},"v1/about/user"," endpoint first.",[119,242,243,246],{},[122,244,245],{},"Benefit:"," Single source of truth for authorization; no separate account needed.",[107,248,249],{},[250,251],"img",{"alt":89,"src":252},"/images/architecture.png",[185,254,256],{"id":255},"data-storage","Data Storage",[116,258,259,269],{},[119,260,261,264,265,268],{},[122,262,263],{},"Local Storage:"," App settings, tags, accounts, categories, budgets, and templates are cached in the browser's ",[111,266,267],{},"localStorage"," for instant access.",[119,270,271,274,275,278,279,282,283,282,286,289],{},[122,272,273],{},"Syncing:"," Data is re-synced every ",[111,276,277],{},"N days"," (configurable). You can manually trigger a sync via ",[111,280,281],{},"Settings"," -> ",[111,284,285],{},"App config",[111,287,288],{},"Save"," or by pulling to refresh on lists.",[102,291,16],{"id":292},"docker",[116,294,295],{},[119,296,297,298,301],{},"exposes a single port to the outside. Inside the container there is an Nginx instance which sends all requests containing ",[111,299,300],{},"/api"," to the backend and all other to the frontend instance.",{"title":303,"searchDepth":304,"depth":304,"links":305},"",2,[306,307,311,314],{"id":104,"depth":304,"text":105},{"id":150,"depth":304,"text":151,"children":308},[309],{"id":187,"depth":310,"text":188},3,{"id":211,"depth":304,"text":212,"children":312},[313],{"id":255,"depth":310,"text":256},{"id":292,"depth":304,"text":16},"Understand how Firefly Pico works under the hood.","md",null,{},true,{"title":89,"description":315},"FMI1CbC01zEZ2c7kooxV-0JW8FBbXR_mgX3oinm9qLY",[323,325],{"title":80,"path":81,"stem":82,"description":324,"children":-1},"Steps to add support for a new language",{"title":93,"path":94,"stem":95,"description":326,"children":-1},"Just like Firefly III this is licensed under the GNU Affero General Public License v3.",1791975937491]