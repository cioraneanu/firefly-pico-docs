OST \\\n  --url \"{PICO_URL}/api/assistant/rambles\" \\\n  --header \"Authorization: Bearer {FIREFLY_TOKEN}\" \\\n  --header \"Content-Type: text/plain\" \\\n  --data \"Coffee this morning 4.50\"\n","bash",[113,162,163,180,197,212,226],{"__ignoreMap":111},[116,164,165,169,173,176],{"class":118,"line":119},[116,166,168],{"class":167},"sBMFI","curl",[116,170,172],{"class":171},"sfazB"," --request",[116,174,175],{"class":171}," POST",[116,177,179],{"class":178},"sTEyZ"," \\\n",[116,181,182,185,189,192,195],{"class":118,"line":125},[116,183,184],{"class":171},"  --url",[116,186,188],{"class":187},"sMK4o"," \"",[116,190,191],{"class":171},"{PICO_URL}/api/assistant/rambles",[116,193,194],{"class":187},"\"",[116,196,179],{"class":178},[116,198,200,203,205,208,210],{"class":118,"line":199},3,[116,201,202],{"class":171},"  --header",[116,204,188],{"class":187},[116,206,207],{"class":171},"Authorization: Bearer {FIREFLY_TOKEN}",[116,209,194],{"class":187},[116,211,179],{"class":178},[116,213,215,217,219,222,224],{"class":118,"line":214},4,[116,216,202],{"class":171},[116,218,188],{"class":187},[116,220,221],{"class":171},"Content-Type: text/plain",[116,223,194],{"class":187},[116,225,179],{"class":178},[116,227,229,232,234,237],{"class":118,"line":228},5,[116,230,231],{"class":171},"  --data",[116,233,188],{"class":187},[116,235,236],{"class":171},"Coffee this morning 4.50",[116,238,239],{"class":187},"\"\n",[102,241,242,243,246],{},"You can also send ",[113,244,245],{},"text"," as a JSON or form field:",[106,248,252],{"className":249,"code":250,"language":251,"meta":111,"style":111},"language-json shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","{\n  \"text\": \"Coffee this morning 4.50\"\n}\n","json",[113,253,254,259,278],{"__ignoreMap":111},[116,255,256],{"class":118,"line":119},[116,257,258],{"class":187},"{\n",[116,260,261,264,267,269,272,274,276],{"class":118,"line":125},[116,262,263],{"class":187},"  \"",[116,265,245],{"class":266},"spNyl",[116,268,194],{"class":187},[116,270,271],{"class":187},":",[116,273,188],{"class":187},[116,275,236],{"class":171},[116,277,239],{"class":187},[116,279,280],{"class":118,"line":199},[116,281,282],{"class":187},"}\n",[140,284,286],{"id":285},"mode-2-audio","Mode 2: audio",[102,288,289,290,152],{},"Use audio mode to upload the recording itself. Pico stores it and uses the server-side transcription service before interpretation. ",[148,291,293],{"href":292},"/ramble/configuration#_2-configure-audio-transcription-optional","Audio transcription must be configured",[102,295,296,297,300],{},"Send a ",[113,298,299],{},"multipart/form-data"," request with:",[302,303,304,320],"table",{},[305,306,307],"thead",{},[308,309,310,314,317],"tr",{},[311,312,313],"th",{},"Field",[311,315,316],{},"Required",[311,318,319],{},"Description",[321,322,323,337,362],"tbody",{},[308,324,325,331,334],{},[326,327,328],"td",{},[113,329,330],{},"voice",[326,332,333],{},"Yes",[326,335,336],{},"Audio file, up to 25 MB.",[308,338,339,344,347],{},[326,340,341],{},[113,342,343],{},"language",[326,345,346],{},"No",[326,348,349,350,353,354,357,358,361],{},"Language hint such as ",[113,351,352],{},"en",", ",[113,355,356],{},"de",", or ",[113,359,360],{},"ro",". It overrides the server default for this recording.",[308,363,364,368,370],{},[326,365,366],{},[113,367,245],{},[326,369,346],{},[326,371,372],{},"Extra text to keep alongside the transcription.",[106,374,376],{"className":158,"code":375,"language":160,"meta":111,"style":111},"curl --request POST \\\n  --url \"{PICO_URL}/api/assistant/rambles\" \\\n  --header \"Authorization: Bearer {FIREFLY_TOKEN}\" \\\n  --form \"voice=@recording.m4a\" \\\n  --form \"language=en\"\n",[113,377,378,388,400,412,426],{"__ignoreMap":111},[116,379,380,382,384,386],{"class":118,"line":119},[116,381,168],{"class":167},[116,383,172],{"class":171},[116,385,175],{"class":171},[116,387,179],{"class":178},[116,389,390,392,394,396,398],{"class":118,"line":125},[116,391,