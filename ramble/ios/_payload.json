1},"Architecture","/about/architecture","6.about/0.architecture",{"title":93,"path":94,"stem":95},"Attribution","/about/attribution","6.about/1.attribution",{"id":97,"title":61,"body":98,"description":221,"extension":222,"links":223,"meta":224,"navigation":225,"path":62,"seo":226,"stem":63,"__hash__":227},"docs/3.ramble/3.ios.md",{"type":99,"value":100,"toc":214},"minimark",[101,105,108,113,120,142,150,154,183,187,191,194,211],[102,103,104],"p",{},"An iOS you can make this process faster by creating a Shortcut and calling it via the Action button, Lock Screen, Home Screen, Siri, or an Apple Watch.",[102,106,107],{},"You then just describe the transaction.",[109,110,112],"h2",{"id":111},"choose-a-shortcut","Choose a shortcut",[102,114,115,119],{},[116,117,118],"strong",{},"Firefly-Pico"," includes two ready-made templates:",[121,122,123,134],"ul",{},[124,125,126,133],"li",{},[127,128,132],"a",{"href":129,"rel":130},"https://github.com/cioraneanu/firefly-pico/raw/main/docs/siri-shortcuts/pico-text-template-signed.shortcut",[131],"nofollow","Text shortcut",": Apple converts your speech to text before sending it. This only requires Ramble's language model configuration.",[124,135,136,141],{},[127,137,140],{"href":138,"rel":139},"https://github.com/cioraneanu/firefly-pico/raw/main/docs/siri-shortcuts/pico-voice-template-signed.shortcut",[131],"Voice shortcut",": the recording is uploaded directly. This is faster to capture and can support languages that Apple dictation does not, but it requires Pico's audio transcription service.",[102,143,144,145,149],{},"These correspond to the two modes described in the ",[127,146,148],{"href":147},"/features/ramble/api","Ramble API reference",".",[109,151,153],{"id":152},"install-a-shortcut","Install a shortcut",[155,156,157,160,166,173,180],"ol",{},[124,158,159],{},"Download the text or voice shortcut on your iPhone.",[124,161,162,163,149],{},"Open it in the Shortcuts app and select ",[116,164,165],{},"Add Shortcut",[124,167,168,169,149],{},"Edit the shortcut and replace the Pico URL with your instance URL, for example ",[170,171,172],"code",{},"https://pico.example.com",[124,174,175,176,179],{},"Replace the authorization value with ",[170,177,178],{},"Bearer "," followed by your Firefly III personal access token.",[124,181,182],{},"Run the shortcut once and allow the requested microphone or network permissions.",[184,185,186],"warning",{},"The shortcut contains your Firefly III token. Do not share or publish the configured shortcut. If the device or shortcut is compromised, revoke the token in Firefly III.",[109,188,190],{"id":189},"make-it-easy-to-launch","Make it easy to launch",[102,192,193],{},"You can assign the shortcut to:",[121,195,196,199,202,205,208],{},[124,197,198],{},"the Action button on supported iPhones;",[124,200,201],{},"a Lock Screen widget;",[124,203,204],{},"a Home Screen icon;",[124,206,207],{},"a Siri phrase;",[124,209,210],{},"an Apple Watch complication.",[102,212,213],{},"Older iPhones without an Action button can use any of the other launch methods.",{"title":215,"searchDepth":216,"depth":216,"links":217},"",2,[218,219,220],{"id":111,"depth":216,"text":112},{"id":152,"depth":216,"text":153},{"id":189,"depth":216,"text":190},"Capture a ramble from an iPhone or Apple Watch and review it later in Pico.","md",null,{},true,{"title":61,"description":221},"aUHsZdpa9e_J-Ld6u_V9uSZJK9hH5i5jGb0yXQ7QflQ",[229,231],{"title":57,"path":58,"stem":59,"description":230,"children":-1},"Save text or audio rambles from automations and other devices.",{"title":70,"path":71,"stem":72,"description":232,"children":-1},"Get the most out of Firefly Pico with this daily workflow.",1791975937491]