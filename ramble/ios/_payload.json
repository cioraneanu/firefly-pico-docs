bution","/about/attribution","6.about/1.attribution",{"id":93,"title":57,"body":94,"description":217,"extension":218,"links":219,"meta":220,"navigation":221,"path":58,"seo":222,"stem":59,"__hash__":223},"docs/3.ramble/3.ios.md",{"type":95,"value":96,"toc":210},"minimark",[97,101,104,109,116,138,146,150,179,183,187,190,207],[98,99,100],"p",{},"An iOS you can make this process faster by creating a Shortcut and calling it via the Action button, Lock Screen, Home Screen, Siri, or an Apple Watch.",[98,102,103],{},"You then just describe the transaction.",[105,106,108],"h2",{"id":107},"choose-a-shortcut","Choose a shortcut",[98,110,111,115],{},[112,113,114],"strong",{},"Firefly-Pico"," includes two ready-made templates:",[117,118,119,130],"ul",{},[120,121,122,129],"li",{},[123,124,128],"a",{"href":125,"rel":126},"https://github.com/cioraneanu/firefly-pico/raw/main/docs/siri-shortcuts/pico-text-template-signed.shortcut",[127],"nofollow","Text shortcut",": Apple converts your speech to text before sending it. This only requires Ramble's language model configuration.",[120,131,132,137],{},[123,133,136],{"href":134,"rel":135},"https://github.com/cioraneanu/firefly-pico/raw/main/docs/siri-shortcuts/pico-voice-template-signed.shortcut",[127],"Voice shortcut",": the recording is uploaded directly. This is faster to capture and can support languages that Apple dictation does not, but it requires Pico's audio transcription service.",[98,139,140,141,145],{},"These correspond to the two modes described in the ",[123,142,144],{"href":143},"/features/ramble/api","Ramble API reference",".",[105,147,149],{"id":148},"install-a-shortcut","Install a shortcut",[151,152,153,156,162,169,176],"ol",{},[120,154,155],{},"Download the text or voice shortcut on your iPhone.",[120,157,158,159,145],{},"Open it in the Shortcuts app and select ",[112,160,161],{},"Add Shortcut",[120,163,164,165,145],{},"Edit the shortcut and replace the Pico URL with your instance URL, for example ",[166,167,168],"code",{},"https://pico.example.com",[120,170,171,172,175],{},"Replace the authorization value with ",[166,173,174],{},"Bearer "," followed by your Firefly III personal access token.",[120,177,178],{},"Run the shortcut once and allow the requested microphone or network permissions.",[180,181,182],"warning",{},"The shortcut contains your Firefly III token. Do not share or publish the configured shortcut. If the device or shortcut is compromised, revoke the token in Firefly III.",[105,184,186],{"id":185},"make-it-easy-to-launch","Make it easy to launch",[98,188,189],{},"You can assign the shortcut to:",[117,191,192,195,198,201,204],{},[120,193,194],{},"the Action button on supported iPhones;",[120,196,197],{},"a Lock Screen widget;",[120,199,200],{},"a Home Screen icon;",[120,202,203],{},"a Siri phrase;",[120,205,206],{},"an Apple Watch complication.",[98,208,209],{},"Older iPhones without an Action button can use any of the other launch methods.",{"title":211,"searchDepth":212,"depth":212,"links":213},"",2,[214,215,216],{"id":107,"depth":212,"text":108},{"id":148,"depth":212,"text":149},{"id":185,"depth":212,"text":186},"Capture a ramble from an iPhone or Apple Watch and review it later in Pico.","md",null,{},true,{"title":57,"description":217},"aUHsZdpa9e_J-Ld6u_V9uSZJK9hH5i5jGb0yXQ7QflQ",[225,227],{"title":53,"path":54,"stem":55,"description":226,"children":-1},"Save text or audio rambles from automations and other devices.",{"title":66,"path":67,"stem":68,"description":228,"children":-1},"Get the most out of Firefly Pico with this daily workflow.",1785485816575]