[{"data":1,"prerenderedAt":245},["ShallowReactive",2],{"navigation_docs":3,"-ramble-ios":96,"-ramble-ios-surround":240},[4,10,24,33,54,73,83],{"title":5,"path":6,"stem":7,"children":8},"Introduction","/introduction","0.introduction/index",[9],{"title":5,"path":6,"stem":7},{"title":11,"path":12,"stem":13,"children":14,"page":23},"Installation","/installation","1.installation",[15,19],{"title":16,"path":17,"stem":18},"Docker","/installation/docker","1.installation/1.docker",{"title":20,"path":21,"stem":22},"From source","/installation/manual","1.installation/2.manual",false,{"title":25,"path":26,"stem":27,"children":28,"page":23},"App guide","/app-guide","2.app-guide",[29],{"title":30,"path":31,"stem":32},"App usage","/app-guide/usage","2.app-guide/1.usage",{"title":34,"path":35,"stem":36,"children":37,"page":23},"Features","/features","3.features",[38,42,46,50],{"title":39,"path":40,"stem":41},"Templates","/features/templates","3.features/1.templates",{"title":43,"path":44,"stem":45},"Assistant","/features/assistant","3.features/2.assistant",{"title":47,"path":48,"stem":49},"Profiles","/features/profiles","3.features/4.profiles",{"title":51,"path":52,"stem":53},"Custom icons","/features/custom-icons","3.features/5.custom-icons",{"title":55,"path":56,"stem":57,"children":58},"Ramble","/ramble","4.ramble",[59,61,65,69],{"title":55,"path":56,"stem":60},"4.ramble/index",{"title":62,"path":63,"stem":64},"Install and configure","/ramble/configuration","4.ramble/1.configuration",{"title":66,"path":67,"stem":68},"Ramble API","/ramble/api","4.ramble/2.api",{"title":70,"path":71,"stem":72},"iOS Shortcuts","/ramble/ios","4.ramble/3.ios",{"title":74,"path":75,"stem":76,"children":77},"Contributing","/contribute","5.contribute/1.index",[78,79],{"title":74,"path":75,"stem":76},{"title":80,"path":81,"stem":82},"Localization","/contribute/localization","5.contribute/2.localization",{"title":84,"path":85,"stem":86,"children":87,"page":23},"About","/about","6.about",[88,92],{"title":89,"path":90,"stem":91},"Architecture","/about/architecture","6.about/0.architecture",{"title":93,"path":94,"stem":95},"Attribution","/about/attribution","6.about/1.attribution",{"id":97,"title":70,"body":98,"description":233,"extension":234,"links":235,"meta":236,"navigation":237,"path":71,"seo":238,"stem":72,"__hash__":239},"docs/4.ramble/3.ios.md",{"type":99,"value":100,"toc":226},"minimark",[101,105,108,113,120,142,149,153,182,186,190,193,210,213],[102,103,104],"p",{},"An iOS you can make this process faster by creating a Shortcut and calling it via the Action button, Lock Screen, Home Screen, Siri, or an Apple Watch.",[102,106,107],{},"You then just describe the transaction.",[109,110,112],"h2",{"id":111},"choose-a-shortcut","Choose a shortcut",[102,114,115,119],{},[116,117,118],"strong",{},"Firefly-Pico"," includes two ready-made templates:",[121,122,123,134],"ul",{},[124,125,126,133],"li",{},[127,128,132],"a",{"href":129,"rel":130},"https://github.com/cioraneanu/firefly-pico/raw/main/docs/siri-shortcuts/pico-text-template-signed.shortcut",[131],"nofollow","Text shortcut",": Apple converts your speech to text before sending it. This only requires Ramble's language model configuration.",[124,135,136,141],{},[127,137,140],{"href":138,"rel":139},"https://github.com/cioraneanu/firefly-pico/raw/main/docs/siri-shortcuts/pico-voice-template-signed.shortcut",[131],"Voice shortcut",": the recording is uploaded directly. This is faster to capture and can support languages that Apple dictation does not, but it requires Pico's audio transcription service.",[102,143,144,145,148],{},"These correspond to the two modes described in the ",[127,146,147],{"href":67},"Ramble API reference",".",[109,150,152],{"id":151},"install-a-shortcut","Install a shortcut",[154,155,156,159,165,172,179],"ol",{},[124,157,158],{},"Download the text or voice shortcut on your iPhone.",[124,160,161,162,148],{},"Open it in the Shortcuts app and select ",[116,163,164],{},"Add Shortcut",[124,166,167,168,148],{},"Edit the shortcut and replace the Pico URL with your instance URL, for example ",[169,170,171],"code",{},"https://pico.example.com",[124,173,174,175,178],{},"Replace the authorization value with ",[169,176,177],{},"Bearer "," followed by your Firefly III personal access token.",[124,180,181],{},"Run the shortcut once and allow the requested microphone or network permissions.",[183,184,185],"warning",{},"The shortcut contains your Firefly III token. Do not share or publish the configured shortcut. If the device or shortcut is compromised, revoke the token in Firefly III.",[109,187,189],{"id":188},"make-it-easy-to-launch","Make it easy to launch",[102,191,192],{},"You can assign the shortcut to:",[121,194,195,198,201,204,207],{},[124,196,197],{},"the Action button on supported iPhones;",[124,199,200],{},"a Lock Screen widget;",[124,202,203],{},"a Home Screen icon;",[124,205,206],{},"a Siri phrase;",[124,208,209],{},"an Apple Watch complication.",[102,211,212],{},"Older iPhones without an Action button can use any of the other launch methods.",[214,215,216,217,220,221,148],"tip",{},"The repository also contains a native iOS app (the ",[169,218,219],{},"ios/"," folder) that wraps Pico and records voice rambles natively from the Action button, Control Center or Lock Screen. You need to build it yourself with Xcode, see ",[127,222,225],{"href":223,"rel":224},"https://github.com/cioraneanu/firefly-pico/blob/main/ios/README.md",[131],"ios/README.md",{"title":227,"searchDepth":228,"depth":228,"links":229},"",2,[230,231,232],{"id":111,"depth":228,"text":112},{"id":151,"depth":228,"text":152},{"id":188,"depth":228,"text":189},"Capture a ramble from an iPhone or Apple Watch and review it later in Pico.","md",null,{},true,{"title":70,"description":233},"STrOWAnfYOPmEeqsKQcOBpRCZsSvgc4n9DI81uE1UsI",[241,243],{"title":66,"path":67,"stem":68,"description":242,"children":-1},"Save text or audio rambles from automations and other devices.",{"title":74,"path":75,"stem":76,"description":244,"children":-1},"How to contribute to Firefly Pico.",1795175690374]