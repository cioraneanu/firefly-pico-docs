ath":90,"stem":91},"Architecture","/about/architecture","6.about/0.architecture",{"title":93,"path":94,"stem":95},"Attribution","/about/attribution","6.about/1.attribution",{"id":97,"title":34,"body":98,"description":287,"extension":288,"links":289,"meta":290,"navigation":291,"path":35,"seo":292,"stem":36,"__hash__":293},"docs/2.features/2.assistant.md",{"type":99,"value":100,"toc":278},"minimark",[101,105,110,117,122,172,176,179,194,264],[102,103,104],"p",{},"The Assistant allows you to easily turn words into a transaction. You can even use your phone's dictation for a hands-free experience! 📢",[106,107,109],"h2",{"id":108},"format","Format",[102,111,112,113],{},"The basic format is:\n",[114,115,116],"code",{},"[Tag / Category / Template] [Amount?] [Description?] [Todo?]",[118,119,121],"h3",{"id":120},"parts","Parts",[123,124,125,150,156,162],"ol",{},[126,127,128,129,133,134,137,138,141,142,145,146,149],"li",{},"The first part tries to identify the transaction type via fuzzy searching your ",[130,131,132],"strong",{},"tags",", ",[130,135,136],{},"categories","\nand ",[130,139,140],{},"templates"," (e.g., ",[114,143,144],{},"elct"," => ",[114,147,148],{},"electricity",").",[126,151,152,155],{},[130,153,154],{},"Amount:"," (optional) Supports mathematical expressions. Numbers separated by a space are automatically added up.",[126,157,158,161],{},[130,159,160],{},"Description:"," (optional). If provided overwrites the default value (tag name / template description).",[126,163,164,167,168,171],{},[130,165,166],{},"Todo:"," (optional) Appending a custom string (default ",[114,169,170],{},"!!",") marks the transaction as a \"Todo\". This string is configurable in Settings.",[106,173,175],{"id":174},"examples","Examples",[102,177,178],{},"Assuming you have:",[180,181,182,188],"ul",{},[126,183,184,187],{},[130,185,186],{},"Tag",": \"Electricity\"",[126,189,190,193],{},[130,191,192],{},"Template",": \"Swimming\"",[195,196,197,210],"table",{},[198,199,200],"thead",{},[201,202,203,207],"tr",{},[204,205,206],"th",{},"Input",[204,208,209],{},"Result",[211,212,213,224,234,244,254],"tbody",{},[201,214,215,221],{},[216,217,218],"td",{},[114,219,220],{},"electricity 23",[216,222,223],{},"Tag: Electricity, Amount: 23",[201,225,226,231],{},[216,227,228],{},[114,229,230],{},"elc 12*2+33",[216,232,233],{},"Tag: Electricity, Amount: 57",[201,235,236,241],{},[216,237,238],{},[114,239,240],{},"elc 12+2*3 custom description",[216,242,243],{},"Tag: Electricity, Amount: 18, Description: \"custom description\"",[201,245,246,251],{},[216,247,248],{},[114,249,250],{},"elc 25 !!",[216,252,253],{},"Tag: Electricity, Amount: 25, Marked as Todo",[201,255,256,261],{},[216,257,258],{},[114,259,260],{},"swim",[216,262,263],{},"Template: Swimming (uses template defaults)",[265,266,267,268,272,273,277],"tip",{},"Want to go one step further and just ",[269,270,271],"em",{},"talk"," at your budget app? Check out ",[274,275,46],"a",{"href":276},"/features/ramble"," — the Assistant's AI-powered big brother.",{"title":279,"searchDepth":280,"depth":280,"links":281},"",2,[282,286],{"id":108,"depth":280,"text":109,"children":283},[284],{"id":120,"depth":285,"text":121},3,{"id":174,"depth":280,"text":175},"Create transactions at the speed of thought.","md",null,{},true,{"title":34,"description":287},"DdA3hDoTwT5aq8GX29xOWvddNdW3iMq8MpkmFxOQoaI",[295,296],{"title":30,"path":31,"stem":32,"description":289,"children":-1},{"title":38,"path":39,"stem":40,"description":297,"children":-1},"Easily switch between your app settings",1791975937491]