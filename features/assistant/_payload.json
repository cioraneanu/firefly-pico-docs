8,92],{"title":89,"path":90,"stem":91},"Architecture","/about/architecture","6.about/0.architecture",{"title":93,"path":94,"stem":95},"Attribution","/about/attribution","6.about/1.attribution",{"id":97,"title":43,"body":98,"description":362,"extension":363,"links":364,"meta":365,"navigation":366,"path":44,"seo":367,"stem":45,"__hash__":368},"docs/3.features/2.assistant.md",{"type":99,"value":100,"toc":351},"minimark",[101,105,110,117,122,196,203,207,227,231,236,240,243,258,338],[102,103,104],"p",{},"The Assistant allows you to easily turn words into a transaction. You can even use your phone's dictation for a hands-free experience! 📢",[106,107,109],"h2",{"id":108},"format","Format",[102,111,112,113],{},"The basic format is:\n",[114,115,116],"code",{},"[Tag / Category / Template] [Amount?] [Description?] [±Nd?] [Todo?]",[118,119,121],"h3",{"id":120},"parts","Parts",[123,124,125,150,156,162,178],"ol",{},[126,127,128,129,133,134,137,138,141,142,145,146,149],"li",{},"The first part tries to identify the transaction type via fuzzy searching your ",[130,131,132],"strong",{},"tags",", ",[130,135,136],{},"categories","\nand ",[130,139,140],{},"templates"," (e.g., ",[114,143,144],{},"elct"," => ",[114,147,148],{},"electricity",").",[126,151,152,155],{},[130,153,154],{},"Amount:"," (optional) Supports mathematical expressions. Numbers separated by a space are automatically added up.",[126,157,158,161],{},[130,159,160],{},"Description:"," (optional). If provided overwrites the default value (tag name / template description).",[126,163,164,167,168,133,171,133,174,177],{},[130,165,166],{},"Date:"," (optional) ",[114,169,170],{},"-1d",[114,172,173],{},"-2d",[114,175,176],{},"+3d"," etc. moves the date N days from today. Without it the date is \"now\".",[126,179,180,183,184,187,188,191,192,195],{},[130,181,182],{},"Todo:"," (optional) Appending a custom string (default ",[114,185,186],{},"!!",") at the end adds your \"todo\" ",[130,189,190],{},"tag"," to the transaction. This string is configurable in ",[114,193,194],{},"Settings -> Assistant",".",[102,197,198,199,202],{},"As you type, the recognized parts show up as chips under the field (template, tag, amount, description, date, todo). Tap the ",[114,200,201],{},"x"," on a chip to remove that part.",[118,204,206],{"id":205},"quick-actions","Quick actions",[102,208,209,210,133,213,216,217,220,221,223,224,226],{},"Next to the field you'll find the ",[130,211,212],{},"Todo",[130,214,215],{},"Yesterday"," and ",[130,218,219],{},"2 days ago"," chips. They add (or remove) the todo marker and the ",[114,222,170],{}," / ",[114,225,173],{}," date parts for you.",[118,228,230],{"id":229},"currency","Currency",[102,232,233,234,195],{},"The currency picker next to the field lets you write the amount in a foreign currency. Pico converts it to the account's currency using the exchange rates. The default currency can be set in ",[114,235,194],{},[106,237,239],{"id":238},"examples","Examples",[102,241,242],{},"Assuming you have:",[244,245,246,252],"ul",{},[126,247,248,251],{},[130,249,250],{},"Tag",": \"Electricity\"",[126,253,254,257],{},[130,255,256],{},"Template",": \"Swimming\"",[259,260,261,274],"table",{},[262,263,264],"thead",{},[265,266,267,271],"tr",{},[268,269,270],"th",{},"Input",[268,272,273],{},"Result",[275,276,277,288,298,308,318,328],"tbody",{},[265,278,279,285],{},[280,281,282],"td",{},[114,283,284],{},"electricity 23",[280,286,287],{},"Tag: Electricity, Amount: 23",[265,289,290,295],{},[280,291,292],{},[114,293,294],{},"elc 12*2+33",[280,296,297],{},"Tag: Electricity, Amount: 57",[265,299,300,305],{},[280,301,302],{},[114,303,304],{},"elc 12+2*3 custom description",[280,306,307],{},"Tag: Electricity, Amount: 18, Description: \"custom description\"",[265,309,310,315],{},[280,311,312],{},[114,313,314],{},"elc 25 !!",[280,316,317],{},"Tag: Electricity, Amount: 25, Marked as Todo",[265,319,320,325],{},[280,321,322],{},[114,323,324],{},"elc 25 -1d",[280,326,327],{},"Tag: Electricity, Amount: 25, Date: yesterday",[265,329,330,335],{},[280,331,332],{},[114,333,334],{},"swim",[280,336,337],{},"Template: Swimming (uses template defaults)",[339,340,341,342,346,347,350],"tip",{},"Want to go one step further and just ",[343,344,345],"em",{},"talk"," at your budget app? Check out ",[348,349,55],"a",{"href":56}," — the Assistant's AI-powered big brother.",{"title":352,"searchDepth":353,"depth":353,"links":354},"",2,[355,361],{"id":108,"depth":353,"text":109,"children":356},[357,359,360],{"id":120,"depth":358,"text":121},3,{"id":205,"depth":358,"text":206},{"id":229,"depth":358,"text":230},{"id":238,"depth":353,"text":239},"Create transactions at the speed of thought.","md",null,{},true,{"title":43,"description":362},"qn9vHjRYeSl4MYIM_zsM-1ypSfy_UyUuw5Gc0EL1Xaw",[370,372],{"title":39,"path":40,"stem":41,"description":371,"children":-1},"Auto-fill the transaction form in one go.",{"title":47,"path":48,"stem":49,"description":373,"children":-1},"Easily switch between your app settings",1795175690374]