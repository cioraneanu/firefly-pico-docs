stem":91},"Attribution","/about/attribution","6.about/1.attribution",{"id":93,"title":34,"body":94,"description":283,"extension":284,"links":285,"meta":286,"navigation":287,"path":35,"seo":288,"stem":36,"__hash__":289},"docs/2.features/2.assistant.md",{"type":95,"value":96,"toc":274},"minimark",[97,101,106,113,118,168,172,175,190,260],[98,99,100],"p",{},"The Assistant allows you to easily turn words into a transaction. You can even use your phone's dictation for a hands-free experience! 📢",[102,103,105],"h2",{"id":104},"format","Format",[98,107,108,109],{},"The basic format is:\n",[110,111,112],"code",{},"[Tag / Category / Template] [Amount?] [Description?] [Todo?]",[114,115,117],"h3",{"id":116},"parts","Parts",[119,120,121,146,152,158],"ol",{},[122,123,124,125,129,130,133,134,137,138,141,142,145],"li",{},"The first part tries to identify the transaction type via fuzzy searching your ",[126,127,128],"strong",{},"tags",", ",[126,131,132],{},"categories","\nand ",[126,135,136],{},"templates"," (e.g., ",[110,139,140],{},"elct"," => ",[110,143,144],{},"electricity",").",[122,147,148,151],{},[126,149,150],{},"Amount:"," (optional) Supports mathematical expressions. Numbers separated by a space are automatically added up.",[122,153,154,157],{},[126,155,156],{},"Description:"," (optional). If provided overwrites the default value (tag name / template description).",[122,159,160,163,164,167],{},[126,161,162],{},"Todo:"," (optional) Appending a custom string (default ",[110,165,166],{},"!!",") marks the transaction as a \"Todo\". This string is configurable in Settings.",[102,169,171],{"id":170},"examples","Examples",[98,173,174],{},"Assuming you have:",[176,177,178,184],"ul",{},[122,179,180,183],{},[126,181,182],{},"Tag",": \"Electricity\"",[122,185,186,189],{},[126,187,188],{},"Template",": \"Swimming\"",[191,192,193,206],"table",{},[194,195,196],"thead",{},[197,198,199,203],"tr",{},[200,201,202],"th",{},"Input",[200,204,205],{},"Result",[207,208,209,220,230,240,250],"tbody",{},[197,210,211,217],{},[212,213,214],"td",{},[110,215,216],{},"electricity 23",[212,218,219],{},"Tag: Electricity, Amount: 23",[197,221,222,227],{},[212,223,224],{},[110,225,226],{},"elc 12*2+33",[212,228,229],{},"Tag: Electricity, Amount: 57",[197,231,232,237],{},[212,233,234],{},[110,235,236],{},"elc 12+2*3 custom description",[212,238,239],{},"Tag: Electricity, Amount: 18, Description: \"custom description\"",[197,241,242,247],{},[212,243,244],{},[110,245,246],{},"elc 25 !!",[212,248,249],{},"Tag: Electricity, Amount: 25, Marked as Todo",[197,251,252,257],{},[212,253,254],{},[110,255,256],{},"swim",[212,258,259],{},"Template: Swimming (uses template defaults)",[261,262,263,264,268,269,273],"tip",{},"Want to go one step further and just ",[265,266,267],"em",{},"talk"," at your budget app? Check out ",[270,271,42],"a",{"href":272},"/features/ramble"," — the Assistant's AI-powered big brother.",{"title":275,"searchDepth":276,"depth":276,"links":277},"",2,[278,282],{"id":104,"depth":276,"text":105,"children":279},[280],{"id":116,"depth":281,"text":117},3,{"id":170,"depth":276,"text":171},"Create transactions at the speed of thought.","md",null,{},true,{"title":34,"description":283},"DdA3hDoTwT5aq8GX29xOWvddNdW3iMq8MpkmFxOQoaI",[291,292],{"title":30,"path":31,"stem":32,"description":285,"children":-1},{"title":38,"path":39,"stem":40,"description":293,"children":-1},"Easily switch between your app settings",1785485816575]